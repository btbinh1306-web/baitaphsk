          "data": {
            "instruction": "Nối từ tiếng Trung với nghĩa tiếng Việt tương ứng",
            "left": ["老师", "学生", "苹果", "医生"],
            "right": ["Học sinh", "Giáo viên", "Bác sĩ", "Quả táo"],
            "answer": [
              [0, 1],
              [1, 0],
              [2, 3],
              [3, 2]
            ]
          }
        }
      ]
    },
